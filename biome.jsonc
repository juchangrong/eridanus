{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  // .gitignore already covers dist and .smoke, the throwaway app the install
  // test builds.
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true,
    "defaultBranch": "main"
  },
  "files": {
    // components/ui and hooks/use-mobile.ts are the shadcn CLI's output and
    // stay as written. .claude holds local tool settings.
    "includes": [
      "**",
      "!src/components/ui",
      "!src/hooks/use-mobile.ts",
      "!.claude"
    ]
  },
  // Indentation and line endings come from .editorconfig.
  "formatter": {
    "enabled": true,
    "useEditorconfig": true,
    // The shadcn CLI writes these and adds to index.css on later installs, so
    // they keep its layout.
    "includes": ["**", "!src/index.css", "!src/lib/utils.ts"]
  },
  "javascript": {
    "formatter": { "quoteStyle": "double" }
  },
  "css": {
    "parser": { "tailwindDirectives": true }
  },
  "linter": {
    "enabled": true,
    "domains": { "react": "recommended" },
    "rules": {
      "preset": "recommended",
      "style": {
        // noUncheckedIndexedAccess makes `!` the way to say an index exists.
        "noNonNullAssertion": "off"
      }
    }
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": { "organizeImports": "on" }
    }
  }
}
