{
  "$schema": "https://ui.shadcn.com/schema/registry.json",
  "name": "eridanus",
  "homepage": "https://github.com/juchangrong/eridanus",
  "include": [
    "src/lib/eridanus/registry.json",
    "src/hooks/eridanus/registry.json",
    "src/components/eridanus/registry.json",
    "skills/registry.json"
  ],
  "items": [
    {
      "name": "base",
      "type": "registry:base",
      "extends": "none",
      "title": "Eridanus base",
      "description": "Starts a project on the Eridanus look: the shadcn base-rhea style on Base UI (preset beqC918K: zinc, Phosphor icons, Inter), JetBrains Mono for code, success/warning/info status colors, and destructive and muted-foreground values that keep text at 4.5:1 or better in both themes, on muted grounds, on badge tints over tinted or hovered table rows, and on the destructive button's hover. Use with `shadcn init`.",
      "categories": ["theme", "setup"],
      "config": {
        "style": "base-rhea",
        "iconLibrary": "phosphor",
        "menuColor": "default",
        "menuAccent": "subtle",
        "tailwind": {
          "baseColor": "zinc"
        }
      },
      "dependencies": [
        "@base-ui/react",
        "class-variance-authority",
        "cn",
        "@phosphor-icons/react",
        "@fontsource-variable/jetbrains-mono"
      ],
      "devDependencies": ["shadcn", "tw-animate-css"],
      "registryDependencies": [
        "utils",
        "font-inter",
        "juchangrong/eridanus/status-colors"
      ],
      "cssVars": {
        "theme": {
          "font-heading": "var(--font-sans)",
          "font-mono": "'JetBrains Mono Variable', ui-monospace, SFMono-Regular, Menlo, monospace"
        },
        "light": {
          "background": "oklch(1 0 0)",
          "foreground": "oklch(0.141 0.005 285.823)",
          "card": "oklch(1 0 0)",
          "card-foreground": "oklch(0.141 0.005 285.823)",
          "popover": "oklch(1 0 0)",
          "popover-foreground": "oklch(0.141 0.005 285.823)",
          "primary": "oklch(0.21 0.006 285.885)",
          "primary-foreground": "oklch(0.985 0 0)",
          "secondary": "oklch(0.967 0.001 286.375)",
          "secondary-foreground": "oklch(0.21 0.006 285.885)",
          "muted": "oklch(0.967 0.001 286.375)",
          "muted-foreground": "oklch(0.52 0.016 285.938)",
          "accent": "oklch(0.967 0.001 286.375)",
          "accent-foreground": "oklch(0.21 0.006 285.885)",
          "destructive": "oklch(0.495 0.202 27.325)",
          "border": "oklch(0.92 0.004 286.32)",
          "input": "oklch(0.92 0.004 286.32)",
          "ring": "oklch(0.705 0.015 286.067)",
          "chart-1": "oklch(0.871 0.006 286.286)",
          "chart-2": "oklch(0.552 0.016 285.938)",
          "chart-3": "oklch(0.442 0.017 285.786)",
          "chart-4": "oklch(0.37 0.013 285.805)",
          "chart-5": "oklch(0.274 0.006 286.033)",
          "radius": "0.625rem",
          "sidebar": "oklch(0.985 0 0)",
          "sidebar-foreground": "oklch(0.141 0.005 285.823)",
          "sidebar-primary": "oklch(0.21 0.006 285.885)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.967 0.001 286.375)",
          "sidebar-accent-foreground": "oklch(0.21 0.006 285.885)",
          "sidebar-border": "oklch(0.92 0.004 286.32)",
          "sidebar-ring": "oklch(0.705 0.015 286.067)"
        },
        "dark": {
          "background": "oklch(0.141 0.005 285.823)",
          "foreground": "oklch(0.985 0 0)",
          "card": "oklch(0.21 0.006 285.885)",
          "card-foreground": "oklch(0.985 0 0)",
          "popover": "oklch(0.21 0.006 285.885)",
          "popover-foreground": "oklch(0.985 0 0)",
          "primary": "oklch(0.92 0.004 286.32)",
          "primary-foreground": "oklch(0.21 0.006 285.885)",
          "secondary": "oklch(0.274 0.006 286.033)",
          "secondary-foreground": "oklch(0.985 0 0)",
          "muted": "oklch(0.274 0.006 286.033)",
          "muted-foreground": "oklch(0.705 0.015 286.067)",
          "accent": "oklch(0.274 0.006 286.033)",
          "accent-foreground": "oklch(0.985 0 0)",
          "destructive": "oklch(0.719 0.175 22.216)",
          "border": "oklch(1 0 0 / 10%)",
          "input": "oklch(1 0 0 / 15%)",
          "ring": "oklch(0.552 0.016 285.938)",
          "chart-1": "oklch(0.871 0.006 286.286)",
          "chart-2": "oklch(0.552 0.016 285.938)",
          "chart-3": "oklch(0.442 0.017 285.786)",
          "chart-4": "oklch(0.37 0.013 285.805)",
          "chart-5": "oklch(0.274 0.006 286.033)",
          "sidebar": "oklch(0.21 0.006 285.885)",
          "sidebar-foreground": "oklch(0.985 0 0)",
          "sidebar-primary": "oklch(0.488 0.243 264.376)",
          "sidebar-primary-foreground": "oklch(0.985 0 0)",
          "sidebar-accent": "oklch(0.274 0.006 286.033)",
          "sidebar-accent-foreground": "oklch(0.985 0 0)",
          "sidebar-border": "oklch(1 0 0 / 10%)",
          "sidebar-ring": "oklch(0.552 0.016 285.938)"
        }
      },
      "css": {
        "@import \"tw-animate-css\"": {},
        "@import \"shadcn/tailwind.css\"": {},
        "@import \"@fontsource-variable/jetbrains-mono\"": {},
        "@layer base": {
          "*": {
            "@apply border-border outline-ring/50": {}
          },
          "body": {
            "@apply bg-background text-foreground": {}
          },
          "code, kbd, samp, pre": {
            "@apply font-mono": {}
          },
          ":root": {
            "color-scheme": "light"
          },
          ".dark": {
            "color-scheme": "dark"
          }
        }
      }
    },
    {
      "name": "status-colors",
      "type": "registry:theme",
      "title": "Status colors",
      "description": "success, warning and info color tokens (bg-success, text-warning, …) for both themes. Text in these colors keeps 4.5:1 or better on the page, on its own badge tint, and on that tint over a tinted, hovered table row: at least 4.56:1 in light mode and 4.81:1 in dark mode.",
      "categories": ["theme"],
      "cssVars": {
        "theme": {
          "color-success": "var(--success)",
          "color-warning": "var(--warning)",
          "color-info": "var(--info)"
        },
        "light": {
          "success": "oklch(0.48 0.132 150.069)",
          "warning": "oklch(0.51 0.136 48.998)",
          "info": "oklch(0.505 0.223 262.881)"
        },
        "dark": {
          "success": "oklch(0.792 0.209 151.711)",
          "warning": "oklch(0.828 0.189 84.429)",
          "info": "oklch(0.707 0.165 254.624)"
        }
      }
    }
  ]
}
